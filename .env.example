# ── Supabase (client — safe to expose, protected by RLS) ─────
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── App ──────────────────────────────────────────────────────
VITE_APP_NAME=FarmCore FMIS
VITE_APP_URL=https://farmcore.vercel.app

# ═════════════════════════════════════════════════════════════
# SERVER-ONLY. Set these in the Vercel dashboard, never in a
# VITE_-prefixed variable and never in a committed .env file —
# anything named VITE_* is compiled into the browser bundle.
# ═════════════════════════════════════════════════════════════

# Service role key. Bypasses ALL row-level security. Required by
# /api/create-user and /api/reset-member-password. Treat it like a
# root password: if it leaks, every farm's data is readable and
# writable by whoever holds it. Rotate in Supabase → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# AI farm brief (/api/farm-brief). Free key at aistudio.google.com.
# Leave blank to disable the feature — the dashboard degrades cleanly.
GEMINI_API_KEY=
